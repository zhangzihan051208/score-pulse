# TheSportsDB (free tier often uses 123)
THESPORTSDB_API_KEY=123

# Esports schedules (use one or both; KashRock is preferred when set)
KASHROCK_API_KEY=
PANDASCORE_API_TOKEN=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: protect POST /api/sync/fixtures
SYNC_SECRET=

# 看台月卡 / Grandstand Monthly, €7 per month.
# Card checkout on the website. The buy button stays unpaid until the secret key is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Play Console service-account JSON, one line. Verifies Android subscription tokens.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Store review. SAFETY_ADMIN_EMAILS is a comma-separated list of login emails
# that can open /safety and hide reported comments.
SAFETY_ADMIN_EMAILS=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
