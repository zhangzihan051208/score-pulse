# TheSportsDB (free tier often uses 123)
THESPORTSDB_API_KEY=123

# Esports schedules (use one or both; KashRock is preferred when set)
KASHROCK_API_KEY=
PANDASCORE_API_TOKEN=

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Protect /api/sync/* and /api/cron/* (Vercel Cron sends Authorization: Bearer CRON_SECRET).
SYNC_SECRET=
CRON_SECRET=

# 看台月卡 / Grandstand Monthly, €7 per month.
# Card checkout on the website. The buy button stays unpaid until the secret key is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Play Console service-account JSON, one line. Verifies Android subscription tokens.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Automatic comment moderation and AI translation of comments into the viewer's language.
# Local rules still run without this key. Translation needs the same key (gpt-4o-mini).
OPENAI_API_KEY=

# Store review. SAFETY_ADMIN_EMAILS is a comma-separated list of login emails
# that can open /safety. Reports are hidden or dismissed by the model.
# The page only keeps a report when the model cannot be reached.
SAFETY_ADMIN_EMAILS=
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_SUPPORT_EMAIL=
